const KB_LAYOUT = [
  ['`','1','2','3','4','5','6','7','8','9','0','-','=','backspace'],
  ['tab','q','w','e','r','t','y','u','i','o','p','[',']','\\'],
  ['caps','a','s','d','f','g','h','j','k','l',';',"'",'enter'],
  ['shift','z','x','c','v','b','n','m',',','.','/','shift'],
  ['space']
];
const KB_LABEL = {
  backspace:'⌫ Backspace', tab:'Tab', caps:'Caps',
  enter:'Enter ↵', shift:'⇧ Shift', space:'Space'
};

const inputEl = $('typingInput');
const textEl  = $('typingText');
const progressBar = $('progressBar');

let mode = 'cn_words';
let targetText = '';
let startTime = null;
let timerInterval = null;
let finished = false;
let inputStarted = false;

function pickRandom(arr, n){
  const out = [];
  for (let i = 0; i < n; i++){
    out.push(arr[Math.floor(Math.random() * arr.length)]);
  }
  return out;
}
function generateText(){
  if (mode === 'cn_words')       return pickRandom(DATA.cn_words, 12).join(' ');
  if (mode === 'cn_sentences')   return pickRandom(DATA.cn_sentences, 1)[0];
  if (mode === 'en_words')       return pickRandom(DATA.en_words, 15).join(' ');
  if (mode === 'en_sentences')   return pickRandom(DATA.en_sentences, 1)[0];
  return '';
}

function escapeChar(c){
  if (c === '<') return '&lt;';
  if (c === '>') return '&gt;';
  if (c === '&') return '&amp;';
  return c;
}
function render(){
  const val = inputEl.value;
  const target = targetText;
  let html = '';
  for (let i = 0; i < target.length; i++){
    const ch = target[i];
    let cls = 'char';
    if (i < val.length){
      cls += val[i] === ch ? ' correct' : ' wrong';
    } else if (i === val.length){
      cls += ' current';
    }
    html += `<span class="${cls}">${escapeChar(ch)}</span>`;
  }
  textEl.innerHTML = html;
}

function updateStats(){
  const val = inputEl.value;
  const target = targetText;
  const elapsed = startTime ? (Date.now() - startTime) / 1000 : 0;

  let correct = 0;
  for (let i = 0; i < val.length; i++){
    if (val[i] === target[i]) correct++;
  }

  const cpm = elapsed > 0.3 ? Math.round(correct / elapsed * 60) : 0;
  const acc = val.length > 0 ? Math.round(correct / val.length * 100) : 100;
  const prog = target.length > 0 ? Math.min(val.length / target.length, 1) : 0;

  $('statTime').textContent = elapsed.toFixed(1);
  $('statCpm').textContent = cpm;
  $('statAcc').textContent = acc + '%';
  $('statProg').textContent = Math.round(prog * 100) + '%';
  progressBar.style.transform = `scaleX(${prog})`;
}

function highlightKey(ch){
  document.querySelectorAll('.key.active').forEach(k => k.classList.remove('active'));
  if (!ch) return;
  const name = ch === ' ' ? 'space' : ch.toLowerCase();
  const key = document.querySelector(`.key[data-key="${CSS.escape(name)}"]`);
  if (key){
    key.classList.add('active');
    clearTimeout(key._t);
    key._t = setTimeout(() => key.classList.remove('active'), 150);
  }
  if (/[A-Z]/.test(ch)){
    const shift = document.querySelector('.key[data-key="shift"]');
    if (shift){
      shift.classList.add('active');
      clearTimeout(shift._t);
      shift._t = setTimeout(() => shift.classList.remove('active'), 150);
    }
  }
}

function newRound(){
  clearInterval(timerInterval);
  timerInterval = null;
  targetText = generateText();
  inputEl.value = '';
  startTime = null;
  inputStarted = false;
  finished = false;

  $('resultMask').classList.remove('show');

  render();
  updateStats();

  textEl.classList.remove('pop');
  void textEl.offsetWidth;
  textEl.classList.add('pop');

  if (!window.matchMedia('(hover: none)').matches){
    inputEl.focus();
  }
}

function finishRound(){
  if (finished) return;
  finished = true;
  clearInterval(timerInterval);
  timerInterval = null;

  const elapsed = startTime ? (Date.now() - startTime) / 1000 : 0;
  const val = inputEl.value;
  let correct = 0;
  for (let i = 0; i < val.length; i++){
    if (val[i] === targetText[i]) correct++;
  }
  const cpm = elapsed > 0.3 ? Math.round(correct / elapsed * 60) : 0;
  const acc = val.length > 0 ? Math.round(correct / val.length * 100) : 100;

  let sub = '继续保持节奏';
  if (cpm >= 400) sub = '🔥 手速惊人，可以去打比赛了';
  else if (cpm >= 260) sub = '⚡ 速度很快，节奏很稳';
  else if (cpm >= 160) sub = '✨ 已经不错了，再来一轮';
  else if (cpm >= 80) sub = '🌱 稳扎稳打，继续加油';
  else sub = '🐢 慢一点没关系，准确更重要';

  $('resCpm').textContent = cpm;
  $('resAcc').textContent = acc + '%';
  $('resTime').textContent = elapsed.toFixed(1) + 's';
  $('resultSub').textContent = sub;

  setTimeout(() => $('resultMask').classList.add('show'), 320);
}

function buildKeyboard(){
  const kb = $('keyboard');
  kb.innerHTML = '';
  KB_LAYOUT.forEach(row => {
    const rowEl = document.createElement('div');
    rowEl.className = 'kb-row';
    row.forEach(k => {
      const keyEl = document.createElement('div');
      keyEl.className = 'key';
      keyEl.dataset.key = k;
      if (k === 'backspace' || k === 'enter') keyEl.classList.add('wider');
      if (k === 'tab' || k === 'caps') keyEl.classList.add('wide');
      if (k === 'shift') keyEl.classList.add('wider');
      if (k === 'space') keyEl.classList.add('space');
      keyEl.textContent = KB_LABEL[k] || k.toUpperCase();
      rowEl.appendChild(keyEl);
    });
    kb.appendChild(rowEl);
  });
}

inputEl.addEventListener('input', () => {
  if (finished) return;

  if (inputEl.value.length > targetText.length){
    inputEl.value = inputEl.value.slice(0, targetText.length);
  }

  if (!inputStarted && inputEl.value.length > 0){
    inputStarted = true;
    startTime = Date.now();
    timerInterval = setInterval(updateStats, 100);
  }

  render();
  updateStats();
  highlightKey(inputEl.value.slice(-1));

  if (inputEl.value.length >= targetText.length){
    finishRound();
  }
});

inputEl.addEventListener('keydown', (e) => {
  if (e.key === 'Tab'){
    e.preventDefault();
    newRound();
  }
});

$('typingWrap').addEventListener('click', () => inputEl.focus());

$('restartBtn').addEventListener('click', newRound);
$('nextBtn').addEventListener('click', newRound);
$('againBtn').addEventListener('click', newRound);
$('nextRoundBtn').addEventListener('click', newRound);

document.querySelectorAll('.mode').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.mode').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    mode = btn.dataset.mode;
    newRound();
  });
});

const savedTheme = localStorage.getItem('mu-theme');
if (savedTheme) document.documentElement.dataset.theme = savedTheme;
$('themeBtn').addEventListener('click', () => {
  const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  document.documentElement.dataset.theme = next;
  localStorage.setItem('mu-theme', next);
});

$('brandBtn').addEventListener('click', () => { location.href = 'index.html'; });

let ticking = false;
window.addEventListener('scroll', () => {
  if (!ticking){
    ticking = true;
    requestAnimationFrame(() => {
      $('nav').classList.toggle('scrolled', window.scrollY > 20);
      ticking = false;
    });
  }
}, { passive: true });

function init(){
  buildKeyboard();
  newRound();
  setTimeout(() => $('loader').classList.add('done'), 550);
}

init();
})();
</script>
